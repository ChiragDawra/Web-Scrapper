# Deal Engine environment — Sprint 3 Task 3.7.
#
# For running this service on its own (`python -m src.main` from this
# directory). Under docker compose these are set in docker-compose.yml and this
# file is not read.
#
# PLACEHOLDERS ONLY. Never commit a real password or token here.

# Required, and deliberately without a default in src/config.py: an engine
# pointed at the wrong database writes deals nobody reads. Either spelling
# works — the SQLAlchemy dialect prefix is stripped before libpq sees it, so
# this can be the same value Alembic uses.
DATABASE_URL=postgresql://businessscrapper:businessscrapper@127.0.0.1:5432/businessscrapper

# Event bus. REDIS_HOST/REDIS_PORT are used when REDIS_URL is unset.
REDIS_URL=redis://127.0.0.1:6379/0

# Names this worker within the deal-engine consumer group. Defaults to
# deal-engine-<pid>, which is enough to tell two local runs apart.
# CONSUMER_NAME=deal-engine-local

# Scoring weights, served by the API Gateway from Sprint 13 Task 13.7. Unset
# until then: the scorer uses its built-in weights and records `builtin-v1`.
# SCORING_CONFIG_URL=http://127.0.0.1:8000/scoring-config

LOG_LEVEL=INFO
