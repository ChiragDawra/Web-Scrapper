# Revalidation Service — Sprint 5 Task 5.4.
#
# Every key here also appears in the root .env.example; this file is the subset
# one container needs, not a second source of truth. Values shown are the compose
# defaults.

# Redis Streams event bus (ADR-006). REDIS_HOST/REDIS_PORT are read only when
# REDIS_URL is unset.
REDIS_URL=redis://127.0.0.1:6379/0

# processed_events dedup only (EVENT_SCHEMAS.md §1, DATABASE_SCHEMA.md §18).
# This service owns no tables of its own — see src/config.py on why it still
# needs a connection. Accepted in either spelling; the postgresql+psycopg://
# dialect prefix is stripped for libpq.
DATABASE_URL=postgresql://businessscrapper:businessscrapper@127.0.0.1:5432/businessscrapper

# Identifies this worker inside the consumer group. Defaults to
# revalidation-service-{pid}, which keeps two local runs distinguishable.
CONSUMER_NAME=revalidation-service-local

# Clamped to 30s and never above it: STATE_TRANSITIONS.md §1 fixes the Bot's
# timeout there, and a longer budget would emit into a window the Bot has already
# closed. Lower is legal and only makes this side give up first.
REVALIDATION_TIMEOUT_SECONDS=30

# Recorded live reads, while the read path is the fixture stub (INPUTS_NEEDED.md
# item 1). Unset means the service's own tests/fixtures/listings directory.
REVALIDATION_FIXTURE_DIR=

LOG_LEVEL=INFO
