# Environment template. Sprint 0 Task 0.6.
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed.
#
# PLACEHOLDERS ONLY. Never commit a real token, password, API key, or session
# cookie here — not even "just as an example"
# (IMPLEMENTATION_ROADMAP.md §5, and Task 0.6's own review checklist).
#
# The local-development values below are non-secret defaults for the throwaway
# docker-compose stack. Every one of them must be overridden in any deployed
# environment.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# These four are read by docker-compose.yml, so host tooling and the container
# stay in agreement. They are local-only credentials against a disposable
# volume, not secrets.
#
# Changing POSTGRES_USER/PASSWORD/DB after the stack has run once requires
# recreating the volume (`docker compose down -v`) — initdb only reads them on
# an empty data directory.
POSTGRES_USER=businessscrapper
POSTGRES_PASSWORD=businessscrapper
POSTGRES_DB=businessscrapper
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional. When set, it wins outright over the POSTGRES_* parts above
# (infra/postgres/migrations/env.py, and every service's DB config).
# Driver must be psycopg v3: postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://businessscrapper:businessscrapper@127.0.0.1:5432/businessscrapper

# ---------------------------------------------------------------------------
# Redis — canonical event bus (EVENT_SCHEMAS.md, ADR-010)
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379/0

# Consumer-group identity. Must be one of event_producer_service (ENUMS.md), as
# it is written to processed_events.consumer_service for dedup and to the
# per-consumer DLQ stream name `{event_type}.dlq.{consumer_service}`
# (EVENT_SCHEMAS.md §8). Each deployable sets its own.
# EVENT_CONSUMER_SERVICE=deal-engine

# ---------------------------------------------------------------------------
# Secrets manager — accounts.credentials_ref (DATABASE_SCHEMA.md §9)
# ---------------------------------------------------------------------------
# accounts.credentials_ref stores a REFERENCE to marketplace login credentials,
# never the credentials themselves, and the account's login email never appears
# in logs — accounts.label is the internal alias used instead.
#
# Provider is undecided (ZIP_10_INFRASTRUCTURE/SECRETS.md is an empty stub;
# IMPLEMENTATION_ROADMAP.md §7 item 2). These keys reserve the shape.
SECRETS_MANAGER_PROVIDER=env
# Reference format written into accounts.credentials_ref, max 200 chars.
# Shape only — resolving it to an actual secret is the Account Service's job.
SECRETS_MANAGER_REF_PREFIX=businessscrapper/accounts
# Example value stored in the column (NOT a secret, just a pointer):
#   businessscrapper/accounts/amazon/acct-01
# SECRETS_MANAGER_URL=

# ---------------------------------------------------------------------------
# API Gateway (API_CONTRACTS.md)
# ---------------------------------------------------------------------------
API_BASE_PATH=/api/v1
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000

# Two distinct bearer credentials per API_CONTRACTS.md preamble.
# Staff sessions for the Admin Dashboard:
ADMIN_AUTH_SECRET=replace-me-generate-a-random-value
# Service-to-service token for the Telegram Bot's synchronous reads. Service
# mesh only — never exposed publicly.
INTERNAL_SERVICE_TOKEN=replace-me-generate-a-random-value

# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------
# From @BotFather. Real value belongs in .env only, never here.
TELEGRAM_BOT_TOKEN=replace-me-telegram-bot-token

# ---------------------------------------------------------------------------
# Marketplace Connectors — one deployable per marketplace
# (SERVICE_INTERFACES.md §1; marketplace_code in ENUMS.md is
#  AMAZON | FLIPKART | MYNTRA | NYKAA)
# ---------------------------------------------------------------------------
# Each connector deployable sets MARKETPLACE_CODE to exactly one of the four and
# reads the matching credential block. Connectors run on a schedule/poll.
# MARKETPLACE_CODE=AMAZON
MARKETPLACE_POLL_INTERVAL_SECONDS=300

# Per-marketplace access. An account is credentials for exactly one marketplace
# — cross-marketplace session sharing is forbidden (DATABASE_SCHEMA.md §9).
AMAZON_API_KEY=replace-me
FLIPKART_API_KEY=replace-me
MYNTRA_API_KEY=replace-me
NYKAA_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Common to every service
# ---------------------------------------------------------------------------
# All timestamps are timestamptz in UTC. Do not change this to a local zone.
TZ=UTC
LOG_LEVEL=INFO
ENVIRONMENT=local

# accounts.daily_spend_used is zeroed by a daily job (DATABASE_SCHEMA.md §9).
# The reset boundary is a wall-clock local date, so it needs its own zone
# independent of TZ above.
DAILY_SPEND_RESET_TZ=Asia/Kolkata

# ---------------------------------------------------------------------------
# Known gaps (recorded, not resolved here)
# ---------------------------------------------------------------------------
# - Secrets-manager provider is undecided; SECRETS_MANAGER_* reserves the shape
#   only. ZIP_10_INFRASTRUCTURE/SECRETS.md is an empty stub.
# - Marketplace access is modelled as a per-marketplace API key. No ZIP_13
#   document specifies the actual auth mechanism for any connector; Sprints 2-4
#   own that and should correct these keys when the mechanism is known.
# - Admin Dashboard frontend vars are absent — its framework is unspecified
#   (IMPLEMENTATION_ROADMAP.md §7 item 1, decided at Sprint 14 Task 14.1).
# - No monitoring, tracing, or cloud/hosting vars: those ZIP_10 documents are
#   empty stubs, and Sprint 16 owns them.
