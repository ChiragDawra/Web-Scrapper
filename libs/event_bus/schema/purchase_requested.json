{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "purchase_requested.json",
  "title": "PURCHASE_REQUESTED payload",
  "description": "EVENT_SCHEMAS.md §4. Producer: telegram-bot. Consumer: order-planner.",
  "type": "object",
  "required": [
    "order_id",
    "deal_id",
    "listing_id",
    "marketplace",
    "telegram_user_id",
    "requested_quantity",
    "unit_price"
  ],
  "additionalProperties": false,
  "properties": {
    "order_id": {
      "description": "Pre-generated by the Bot, becomes orders.id.",
      "$ref": "common.json#/$defs/uuid"
    },
    "deal_id": { "$ref": "common.json#/$defs/uuid" },
    "listing_id": { "$ref": "common.json#/$defs/uuid" },
    "marketplace": {
      "description": "Carried forward from the DEAL_SCORED payload the Bot received, not re-derived.",
      "$ref": "common.json#/$defs/marketplace_code"
    },
    "telegram_user_id": { "$ref": "common.json#/$defs/uuid" },
    "requested_quantity": { "type": "integer", "exclusiveMinimum": 0 },
    "unit_price": {
      "description": "Price at confirmation time.",
      "$ref": "common.json#/$defs/paise"
    }
  }
}
